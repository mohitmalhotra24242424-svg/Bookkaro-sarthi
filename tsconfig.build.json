{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false
  },
  "include": [
    "shared/**/*.ts",
    "ai/**/*.ts",
    "tools/**/*.ts",
    "railway/**/*.ts",
    "booking/**/*.ts",
    "wallet/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": ["tests", "node_modules", "dist", "app", "scripts"]
}
